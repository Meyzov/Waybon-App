<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Waybon.App.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:Waybon.App.Models"
    x:Class="Waybon.App.Views.Components.GroupsSectionView"
    x:DataType="vm:MainViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border
        Style="{StaticResource CardBorder}"
        Margin="16"
        Padding="16">

        <Grid
            x:Name="GroupScope"
            BindingContext="{Binding Group}"
            x:DataType="vm:GroupViewModel">

            <!-- Group list view -->
            <Grid
                IsVisible="{Binding AreGroupsVisible}"
                RowDefinitions="Auto,Auto,*"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">

                <VerticalStackLayout
                    Spacing="0"
                    Margin="0,0,0,16">
                    <Border
                        Style="{StaticResource SectionHeaderBorder}">
                        <Label
                            Text="Mis Grupos"
                            Style="{StaticResource SectionHeaderLabel}"/>
                    </Border>
                </VerticalStackLayout>

                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16"
                    Margin="0,0,0,16">
                    <Button
                        Text="Crear grupo"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ShowCreateGroupCommand}"/>
                    <Button
                        Grid.Column="1"
                        Text="Unirse a grupo"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ShowJoinGroupCommand}"/>
                </Grid>

                <Grid
                    Grid.Row="2"
                    VerticalOptions="Fill">
                    <Label
                        Text="Cargando grupos..."
                        IsVisible="{Binding IsGroupsLoaderVisible}"
                        FontFamily="Text-Variable"
                        FontSize="16"
                        TextColor="{StaticResource Stone500}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"/>

                    <CollectionView
                        ItemsSource="{Binding JoinedGroups}"
                        IsVisible="{Binding AreGroupsVisible}"
                        VerticalOptions="Fill"
                        VerticalScrollBarVisibility="Never">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                Orientation="Vertical"
                                Span="1"
                                VerticalItemSpacing="16"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate
                                x:DataType="models:GroupDetails">
                                <Border
                                    BackgroundColor="{StaticResource Stone50}"
                                    Stroke="{StaticResource Stone300}"
                                    StrokeThickness="1"
                                    StrokeShape="Rectangle"
                                    Padding="16">

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup
                                            x:Name="CommonStates">
                                            <VisualState
                                                x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="{StaticResource Stone50}"/>
                                                    <Setter
                                                        Property="Stroke"
                                                        Value="{StaticResource Stone300}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState
                                                x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="{StaticResource Stone200}"/>
                                                    <Setter
                                                        Property="Stroke"
                                                        Value="{StaticResource Stone800}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupViewModel}}, Path=SelectGroupCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout
                                        Spacing="0">
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto">
                                            <Border
                                                WidthRequest="50"
                                                HeightRequest="50"
                                                Style="{StaticResource IconContainer}"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                                <Path
                                                    Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                                    Fill="{StaticResource Stone400}"
                                                    Aspect="Uniform"
                                                    HeightRequest="30"
                                                    WidthRequest="30"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </Border>
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                FontFamily="Text-Variable"
                                                FontSize="16"
                                                TextColor="{StaticResource Stone700}"
                                                VerticalOptions="Center"
                                                Margin="16,0,0,0"/>
                                            <Path
                                                Grid.Column="2"
                                                Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"
                                                Fill="{StaticResource Stone400}"
                                                Aspect="Uniform"
                                                HeightRequest="16"
                                                WidthRequest="15"
                                                VerticalOptions="Center"
                                                HorizontalOptions="End"/>
                                        </Grid>

                                        <BoxView
                                            Style="{StaticResource Divider}"
                                            Margin="0,16,0,16"/>

                                        <Border
                                            BackgroundColor="{StaticResource White}"
                                            Stroke="{StaticResource Stone300}"
                                            StrokeThickness="1"
                                            StrokeShape="Rectangle"
                                            Padding="12,8"
                                            Margin="0,0,0,16"
                                            HorizontalOptions="Start">
                                            <Label
                                                Text="{Binding DisplayUsername, StringFormat='Propietario: {0}'}"
                                                FontFamily="Text-Variable"
                                                FontSize="11"
                                                TextColor="{StaticResource Stone500}"
                                                LineBreakMode="NoWrap"/>
                                        </Border>

                                        <Label
                                            Text="{Binding CreatedAt, StringFormat='Creado: {0:dd/MM/yyyy}'}"
                                            FontFamily="Text-Variable"
                                            FontSize="11"
                                            TextColor="{StaticResource Stone500}"
                                            HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label
                        IsVisible="{Binding IsNoGroupsMessageVisible}"
                        Text="No se encontraron grupos."
                        FontFamily="Text-Variable"
                        FontSize="16"
                        TextColor="{StaticResource Stone500}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Members view -->
            <Grid
                IsVisible="{Binding AreMembersVisible}"
                RowDefinitions="Auto,Auto,*,Auto"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">

                <VerticalStackLayout
                    Spacing="0"
                    Margin="0,0,0,16">
                    <Border
                        Style="{StaticResource SectionHeaderBorder}">
                        <Label
                            Text="{Binding SelectedGroupName}"
                            Style="{StaticResource SectionHeaderLabel}"/>
                    </Border>
                </VerticalStackLayout>

                <Grid
                    Grid.Row="2"
                    VerticalOptions="Fill">
                    <Label
                        Text="Cargando miembros..."
                        IsVisible="{Binding IsMembersLoaderVisible}"
                        FontFamily="Text-Variable"
                        FontSize="16"
                        TextColor="{StaticResource Stone500}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"/>

                    <CollectionView
                        ItemsSource="{Binding GroupMembers}"
                        IsVisible="{Binding AreMembersVisible}"
                        VerticalOptions="Fill"
                        VerticalScrollBarVisibility="Never">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                Orientation="Vertical"
                                Span="1"
                                VerticalItemSpacing="16"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate
                                x:DataType="models:GroupMember">
                                <Border
                                    Style="{StaticResource CardBorderLight}"
                                    Padding="16"
                                    InputTransparent="{Binding IsCurrentUser}">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupViewModel}}, Path=SelectMemberCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                        
                                    <VerticalStackLayout
                                        Spacing="0">

                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto">
                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="50"
                                                HeightRequest="50"
                                                Style="{StaticResource IconContainer}"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                                <Path
                                                    Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                                    Fill="{StaticResource Stone400}"
                                                    Aspect="Uniform"
                                                    HeightRequest="24"
                                                    WidthRequest="20"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </Border>
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding DisplayUsername}"
                                                FontFamily="Text-Variable"
                                                FontSize="16"
                                                TextColor="{StaticResource Stone700}"
                                                VerticalOptions="Center"
                                                Margin="16,0,0,0"/>
                                            <Path
                                                Grid.Column="2"
                                                Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"
                                                Fill="{StaticResource Stone400}"
                                                Aspect="Uniform"
                                                HeightRequest="16"
                                                WidthRequest="15"
                                                VerticalOptions="Center"
                                                HorizontalOptions="End"
                                                IsVisible="{Binding IsCurrentUser, Converter={StaticResource InvertedBoolConverter}}"/>
                                        </Grid>

                                        <BoxView
                                            Style="{StaticResource Divider}"
                                            Margin="0,16,0,16"/>

                                        <VerticalStackLayout
                                            Spacing="0">
                                            <FlexLayout
                                                Direction="Row"
                                                Wrap="Wrap"
                                                AlignItems="Start"
                                                JustifyContent="Start"
                                                Margin="0,0,0,16"
                                                BindableLayout.ItemsSource="{Binding Tags}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate
                                                        x:DataType="x:String">
                                                        <Border
                                                            BackgroundColor="{StaticResource White}"
                                                            Stroke="{StaticResource Stone300}"
                                                            StrokeThickness="1"
                                                            StrokeShape="Rectangle"
                                                            Padding="12,8"
                                                            Margin="0,0,4,4">
                                                            <HorizontalStackLayout
                                                                Spacing="8"
                                                                VerticalOptions="Center">
            
                                                                <Border
                                                                    WidthRequest="14"
                                                                    HeightRequest="14"
                                                                    StrokeThickness="0"
                                                                    VerticalOptions="Center"
                                                                    IsVisible="False">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle
                                                                            CornerRadius="100"/>
                                                                    </Border.StrokeShape>
                                                                    <Border.Triggers>
                                                                        <DataTrigger
                                                                            TargetType="Border"
                                                                            Binding="{Binding .}"
                                                                            Value="Compartiendo">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                            <Setter Property="BackgroundColor" Value="Green"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger
                                                                            TargetType="Border"
                                                                            Binding="{Binding .}"
                                                                            Value="No Compartiendo">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                            <Setter Property="BackgroundColor" Value="Red"/>
                                                                        </DataTrigger>
                                                                    </Border.Triggers>
                                                                </Border>

                                                                <Path
                                                                    Aspect="Uniform"
                                                                    HeightRequest="14"
                                                                    WidthRequest="14"
                                                                    VerticalOptions="Center"
                                                                    Fill="{StaticResource Stone500}"
                                                                    IsVisible="False">
                                                                    <Path.Triggers>
                                                                        <DataTrigger
                                                                            TargetType="Path"
                                                                            Binding="{Binding .}"
                                                                            Value="Bloqueado">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                            <Setter Property="Data" Value="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger
                                                                            TargetType="Path"
                                                                            Binding="{Binding .}"
                                                                            Value="Te bloqueó">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                            <Setter Property="Data" Value="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-1.87.63-3.59 1.68-4.96l11.28 11.28C15.59 19.37 13.87 20 12 20zm6.32-3.04L7.04 5.68C8.41 4.63 10.13 4 12 4c4.41 0 8 3.59 8 8 0 1.87-.63 3.59-1.68 4.96z"/>
                                                                        </DataTrigger>
                                                                    </Path.Triggers>
                                                                </Path>
            
                                                                <Label
                                                                    Text="{Binding .}"
                                                                    FontFamily="Text-Variable"
                                                                    FontSize="11"
                                                                    TextColor="{StaticResource Stone500}"
                                                                    VerticalOptions="Center"
                                                                    LineBreakMode="NoWrap"/>
                                                            </HorizontalStackLayout>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>

                                            <Label
                                                Text="{Binding LastActivityAt, StringFormat='Última actividad: {0:dd/MM/yyyy - HH:mm}'}"
                                                FontFamily="Text-Variable"
                                                FontSize="11"
                                                TextColor="{StaticResource Stone500}"
                                                HorizontalOptions="End"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label
                        IsVisible="{Binding IsNoMembersMessageVisible}"
                        Text="No se encontraron miembros en este grupo."
                        FontFamily="Text-Variable"
                        FontSize="16"
                        TextColor="{StaticResource Stone500}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"/>
                </Grid>

                <Grid
                    Grid.Row="3"
                    RowDefinitions="Auto,Auto"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                    <BoxView
                        Grid.Row="0"
                        Style="{StaticResource Divider}"
                        Margin="0,16,0,16"
                        HorizontalOptions="Fill"/>

                    <Grid 
                        Grid.Row="1"
                        ColumnDefinitions="*,Auto" 
                        ColumnSpacing="16"
                        HorizontalOptions="Fill">

                        <Button
                            Grid.Column="0"
                            Text="Volver a mis grupos"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BackToGroupsCommand}"
                            HorizontalOptions="Fill"/>

                        <Grid
                            Grid.Column="1"
                            HeightRequest="40"
                            WidthRequest="50"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                            <Button 
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ShowGroupSettingsCommand}"
                                CornerRadius="0"
                                Padding="0"
                                BackgroundColor="{StaticResource Stone800}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"/>

                            <Path
                                Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.33 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94l-0.36,-2.54c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41l-3.84,0c-0.24,0 -0.43,0.17 -0.47,0.41l-0.36,2.54c-0.59,0.24 -1.13,0.57 -1.62,0.94l-2.39,-0.96c-0.22,-0.08 -0.47,0 -0.59,0.22l-1.92,3.32c-0.12,0.2 -0.07,0.47 0.12,0.61l2.03,1.58c-0.05,0.3 -0.07,0.62 -0.07,0.94c0,0.32 0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41l3.84,0c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.2 0.07,-0.47 -0.12,-0.61l-2.01,-1.58zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6c0,-1.98 1.62,-3.6 3.6,-3.6c1.98,0 3.6,1.62 3.6,3.6c0,1.98 -1.62,3.6 -3.6,3.6z"
                                Fill="{StaticResource Stone100}"
                                Aspect="Uniform"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                InputTransparent="True"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            
            <!-- Group Settings -->
            <Grid
                IsVisible="{Binding IsGroupSettingsVisible}"
                RowDefinitions="Auto,*,Auto"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">

                <!-- Header -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Spacing="0"
                    Margin="0,0,0,16">
                    <Border
                        Style="{StaticResource SectionHeaderBorder}">
                        <Label
                            Text="Configuración de Grupo"
                            Style="{StaticResource SectionHeaderLabel}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Scrollable Content -->
                <ScrollView
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Never"
                    VerticalOptions="Fill">

                    <VerticalStackLayout
                        Spacing="16"
                        Margin="0,0,0,16">

                        <Border
                            IsVisible="{Binding IsCurrentUserOwner}"
                            Style="{StaticResource CardBorderLight}"
                            Padding="16">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto">

                                <Label
                                    Grid.ColumnSpan="2"
                                    Text="Código de invitación"
                                    Style="{StaticResource FormLabel}"
                                    Margin="0,0,0,16"/>

                                <Border
                                    Grid.Row="1"
                                    BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource Stone300}"
                                    StrokeThickness="1"
                                    StrokeShape="Rectangle"
                                    Padding="12,8"
                                    Margin="0,0,16,0">

                                    <Label
                                        Text="{Binding SelectedGroupJoinCode}"
                                        FontFamily="Text-Variable"
                                        FontSize="14"
                                        TextColor="{StaticResource Stone800}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="Regenerar"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RegenerateJoinCodeCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Danger Zone -->
                        <VerticalStackLayout
                            Spacing="16">

                            <BoxView
                                Style="{StaticResource Divider}"
                                Margin="0,369,0,0"/>

                            <HorizontalStackLayout
                                Spacing="6"
                                VerticalOptions="Center">

                                <Border
                                    BackgroundColor="#FEF2F2"
                                    Stroke="#FCA5A5"
                                    StrokeThickness="1"
                                    Padding="8,4"
                                    StrokeShape="Rectangle">

                                    <HorizontalStackLayout
                                        Spacing="6"
                                        VerticalOptions="Center">

                                        <Path
                                            Data="M12 2L1 21h22L12 2zm1 14h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                            Fill="#DC2626"
                                            Aspect="Uniform"
                                            HeightRequest="12"
                                            WidthRequest="12"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="ZONA DE PELIGRO"
                                            FontFamily="Text-Variable"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="#DC2626"
                                            VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>

                            <Border
                                IsVisible="{Binding IsCurrentUserOwner, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource Stone50}"
                                Stroke="{StaticResource Stone300}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="16">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                        <Label
                                            Text="Abandonar grupo"
                                            FontFamily="Text-Variable"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Stone800}"/>
                                        <Label
                                            Text="Ya no tendrás acceso a este grupo"
                                            FontFamily="Text-Variable"
                                            FontSize="11"
                                            TextColor="{StaticResource Stone500}"/>
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="1"
                                        Text="Salir"
                                        Style="{StaticResource PrimaryButton}"
                                        BackgroundColor="#DC2626"
                                        TextColor="{StaticResource White}"
                                        FontSize="13"
                                        HeightRequest="36"
                                        Padding="16,0"
                                        CornerRadius="0"
                                        VerticalOptions="Center"
                                        Command="{Binding LeaveGroupCommand}"/>
                                </Grid>
                            </Border>

                            <Border
                                IsVisible="{Binding IsCurrentUserOwner}"
                                BackgroundColor="{StaticResource Stone50}"
                                Stroke="{StaticResource Stone300}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="16">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="16">

                                    <VerticalStackLayout
                                        VerticalOptions="Center"
                                        Spacing="4">

                                        <Label
                                            Text="Eliminar grupo"
                                            FontFamily="Text-Variable"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Stone800}"/>

                                        <Label
                                            Text="Esta acción es permanente"
                                            FontFamily="Text-Variable"
                                            FontSize="11"
                                            TextColor="{StaticResource Stone500}"/>
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="1"
                                        Text="Eliminar"
                                        Style="{StaticResource PrimaryButton}"
                                        BackgroundColor="#DC2626"
                                        TextColor="{StaticResource White}"
                                        FontSize="13"
                                        HeightRequest="36"
                                        Padding="16,0"
                                        CornerRadius="0"
                                        VerticalOptions="Center"
                                        Command="{Binding DeleteGroupCommand}"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer -->
                <Grid 
                    Grid.Row="2"
                    RowDefinitions="Auto,Auto"
                    HorizontalOptions="Fill"
                    VerticalOptions="End">

                    <BoxView
                        Grid.Row="0"
                        Style="{StaticResource Divider}"
                        Margin="0,0,0,16"
                        HorizontalOptions="Fill"/>

                    <Button
                        Grid.Row="1"
                        Text="Volver a miembros"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding HideGroupSettingsCommand}"
                        HorizontalOptions="Fill"/>
                </Grid>
            </Grid>

            <!-- Member Settings Panel -->
            <Grid
                IsVisible="{Binding IsMemberSettingsVisible}"
                RowDefinitions="Auto,*,Auto"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">

                <!-- Header -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Spacing="0"
                    Margin="0,0,0,16">
                    <Border
                        Style="{StaticResource SectionHeaderBorder}">
                        <Label
                            Text="Configuración de Miembro"
                            Style="{StaticResource SectionHeaderLabel}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Scrollable Content -->
                <ScrollView
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Never"
                    VerticalOptions="Fill">

                    <VerticalStackLayout
                        Spacing="16"
                        Margin="0,0,0,16">

                        <!-- Member Profile Card -->
                        <Border
                            Style="{StaticResource CardBorderLight}"
                            Padding="16"
                            BindingContext="{Binding SelectedMember}"
                            x:DataType="models:GroupMember">

                            <VerticalStackLayout Spacing="0">
                                <HorizontalStackLayout Spacing="16">
                                    <Border
                                        WidthRequest="50"
                                        HeightRequest="50"
                                        Style="{StaticResource IconContainer}"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                        <Path
                                            Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                            Fill="{StaticResource Stone400}"
                                            Aspect="Uniform"
                                            HeightRequest="24"
                                            WidthRequest="20"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>
                                    </Border>

                                    <Label
                                        Text="{Binding DisplayUsername}"
                                        FontFamily="Text-Variable"
                                        FontSize="16"
                                        TextColor="{StaticResource Stone700}"
                                        VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <BoxView
                                    Style="{StaticResource Divider}"
                                    Margin="0,16,0,16"/>

                                <VerticalStackLayout Spacing="0">
                                    <FlexLayout
                                        Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Start"
                                        JustifyContent="Start"
                                        Margin="0,0,0,16"
                                        BindableLayout.ItemsSource="{Binding Tags}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="x:String">
                                                <Border
                                                    BackgroundColor="{StaticResource White}"
                                                    Stroke="{StaticResource Stone300}"
                                                    StrokeThickness="1"
                                                    StrokeShape="Rectangle"
                                                    Padding="12,8"
                                                    Margin="0,0,4,4">
                                                    <HorizontalStackLayout
                                                        Spacing="8"
                                                        VerticalOptions="Center">
            
                                                        <Border
                                                            WidthRequest="14"
                                                            HeightRequest="14"
                                                            StrokeThickness="0"
                                                            VerticalOptions="Center"
                                                            IsVisible="False">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle
                                                                    CornerRadius="100"/>
                                                            </Border.StrokeShape>
                                                            <Border.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Border"
                                                                    Binding="{Binding .}"
                                                                    Value="Compartiendo">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                    <Setter Property="BackgroundColor" Value="Green"/>
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    TargetType="Border"
                                                                    Binding="{Binding .}"
                                                                    Value="No Compartiendo">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                    <Setter Property="BackgroundColor" Value="Red"/>
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                        </Border>

                                                        <Path
                                                            Aspect="Uniform"
                                                            HeightRequest="14"
                                                            WidthRequest="14"
                                                            VerticalOptions="Center"
                                                            Fill="{StaticResource Stone500}"
                                                            IsVisible="False">
                                                            <Path.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Path"
                                                                    Binding="{Binding .}"
                                                                    Value="Bloqueado">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                    <Setter Property="Data" Value="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    TargetType="Path"
                                                                    Binding="{Binding .}"
                                                                    Value="Te bloqueó">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                    <Setter Property="Data" Value="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-1.87.63-3.59 1.68-4.96l11.28 11.28C15.59 19.37 13.87 20 12 20zm6.32-3.04L7.04 5.68C8.41 4.63 10.13 4 12 4c4.41 0 8 3.59 8 8 0 1.87-.63 3.59-1.68 4.96z"/>
                                                                </DataTrigger>
                                                            </Path.Triggers>
                                                        </Path>
            
                                                        <Label
                                                            Text="{Binding .}"
                                                            FontFamily="Text-Variable"
                                                            FontSize="11"
                                                            TextColor="{StaticResource Stone500}"
                                                            VerticalOptions="Center"
                                                            LineBreakMode="NoWrap"/>
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                    
                                    <Label
                                        Text="{Binding LastActivityAt, StringFormat='Última actividad: {0:dd/MM/yyyy - HH:mm}'}"
                                        FontFamily="Text-Variable"
                                        FontSize="11"
                                        TextColor="{StaticResource Stone500}"
                                        HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <BoxView
                            Style="{StaticResource Divider}"
                            Margin="0,0,0,0"/>
                        
                        <VerticalStackLayout Spacing="16">
                            <Border Style="{StaticResource CardBorderLight}" Padding="16">
                                <VerticalStackLayout Spacing="12">
            
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            Text="Compartir ubicación"
                                            Style="{StaticResource BoldLabel}"
                                            TextColor="{StaticResource Stone800}"/>
                                        <Label
                                            Text="Controla si este usuario puede ver tu ubicación actual."
                                            Style="{StaticResource BodyLabel}"
                                            FontSize="11"
                                            TextColor="{StaticResource Stone500}"/>
                                    </VerticalStackLayout>

                                    <Button
                                        Text="{Binding SelectedMemberBlockButtonText}"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="13"
                                        HeightRequest="40"
                                        HorizontalOptions="Fill"
                                        Command="{Binding ToggleBlockMemberCommand}"/>
                
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Danger Zone -->
                        <VerticalStackLayout
                            Spacing="16"
                            IsVisible="{Binding IsCurrentUserOwner}">

                            <BoxView
                                Style="{StaticResource Divider}"
                                Margin="0,169,0,0"/>

                            <HorizontalStackLayout
                                Spacing="6"
                                VerticalOptions="Center">

                                <Border
                                    BackgroundColor="#FEF2F2"
                                    Stroke="#FCA5A5"
                                    StrokeThickness="1"
                                    Padding="8,4"
                                    StrokeShape="Rectangle">

                                    <HorizontalStackLayout
                                        Spacing="6"
                                        VerticalOptions="Center">

                                        <Path
                                            Data="M12 2L1 21h22L12 2zm1 14h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                            Fill="#DC2626"
                                            Aspect="Uniform"
                                            HeightRequest="14"
                                            WidthRequest="14"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="ZONA DE PELIGRO"
                                            FontFamily="Text-Variable"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="#DC2626"
                                            VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>

                            <Border
                                BackgroundColor="{StaticResource Stone50}"
                                Stroke="{StaticResource Stone300}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="16">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="16">

                                    <VerticalStackLayout
                                        VerticalOptions="Center"
                                        Spacing="4">

                                        <Label
                                            Text="Expulsar del grupo"
                                            FontFamily="Text-Variable"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Stone800}"/>

                                        <Label
                                            Text="El usuario tendrá que usar el código para volver a entrar"
                                            FontFamily="Text-Variable"
                                            FontSize="11"
                                            TextColor="{StaticResource Stone500}"/>
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="1"
                                        Text="Expulsar"
                                        Style="{StaticResource PrimaryButton}"
                                        BackgroundColor="#DC2626"
                                        TextColor="{StaticResource White}"
                                        FontSize="13"
                                        HeightRequest="36"
                                        Padding="16,0"
                                        CornerRadius="0"
                                        VerticalOptions="Center"
                                        Command="{Binding KickMemberCommand}"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer -->
                <Grid 
                    Grid.Row="2"
                    RowDefinitions="Auto,Auto"
                    HorizontalOptions="Fill"
                    VerticalOptions="End">

                    <BoxView
                        Grid.Row="0"
                        Style="{StaticResource Divider}"
                        Margin="0,0,0,16"
                        HorizontalOptions="Fill"/>

                    <Button
                        Grid.Row="1"
                        Text="Volver a miembros"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding BackToMembersCommand}"
                        HorizontalOptions="Fill"/>
                </Grid>
            </Grid>

            <!-- Create group panel -->
            <Grid
                IsVisible="{Binding IsCreateGroupPanelVisible}"
                RowDefinitions="Auto,*,Auto"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="0" Margin="0,0,0,16">
                    <Border
                        Style="{StaticResource SectionHeaderBorder}">
                        <Label
                            Text="Crear Nuevo Grupo"
                            Style="{StaticResource SectionHeaderLabel}"/>
                    </Border>
                </VerticalStackLayout>

                <Border
                    Grid.Row="1"
                    Style="{StaticResource CardBorderLight}"
                    Padding="16"
                    VerticalOptions="Start"
                    Margin="0,0,0,16">

                    <VerticalStackLayout
                        Spacing="0">

                        <Border
                            WidthRequest="76"
                            HeightRequest="76"
                            Style="{StaticResource IconContainer}"
                            HorizontalOptions="Center"
                            Margin="0,0,0,16">

                            <Path
                                Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z M18 4v4 M16 6h4"
                                Fill="{StaticResource Stone400}"
                                Aspect="Uniform"
                                HeightRequest="38"
                                WidthRequest="38"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                        </Border>

                        <BoxView
                            Style="{StaticResource Divider}"
                            Margin="0,0,0,16"/>

                        <Label
                            Text="Nombre del grupo"
                            Style="{StaticResource FormLabel}"
                            Margin="0,0,0,8"/>

                        <Border
                            Stroke="{StaticResource Stone300}"
                            StrokeThickness="1"
                            StrokeShape="Rectangle"
                            BackgroundColor="{StaticResource White}"
                            Padding="12,8">

                            <Entry
                                Text="{Binding NewGroupName}"
                                Placeholder="Ej: Familia West"
                                Style="{StaticResource FormEntry}"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16">

                    <Button
                        Text="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCreateGroupCommand}"/>

                    <Button
                        Grid.Column="1"
                        Text="Crear"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CreateGroupCommand}"/>
                </Grid>
            </Grid>

            <!-- Join group panel -->
            <Grid
                IsVisible="{Binding IsJoinGroupPanelVisible}"
                RowDefinitions="Auto,*,Auto"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="0" Margin="0,0,0,16">
                    <Border
                        Style="{StaticResource SectionHeaderBorder}">
                        <Label
                            Text="Unirse a un Grupo"
                            Style="{StaticResource SectionHeaderLabel}"/>
                    </Border>
                </VerticalStackLayout>

                <Border
                    Grid.Row="1"
                    Style="{StaticResource CardBorderLight}"
                    Padding="16"
                    VerticalOptions="Start"
                    Margin="0,0,0,16">
                    <VerticalStackLayout
                        Spacing="0">
                        <Border
                            WidthRequest="76"
                            HeightRequest="76"
                            Style="{StaticResource IconContainer}"
                            HorizontalOptions="Center"
                            Margin="0,0,0,16">
                            <Path
                                Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z M15 12l4 4m0 0l-4 4m4-4H9"
                                Fill="{StaticResource Stone400}"
                                Aspect="Uniform"
                                HeightRequest="38"
                                WidthRequest="38"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                        </Border>

                        <BoxView
                            Style="{StaticResource Divider}"
                            Margin="0,0,0,16"/>

                        <Label
                            Text="Código de invitación"
                            Style="{StaticResource FormLabel}"
                            Margin="0,0,0,8"/>

                        <Border
                            Stroke="{StaticResource Stone300}"
                            StrokeThickness="1"
                            StrokeShape="Rectangle"
                            BackgroundColor="{StaticResource White}"
                            Padding="12,8">
                            <Entry
                                Text="{Binding JoinCodeInput}"
                                Placeholder="Ej: XYZ123"
                                Style="{StaticResource FormEntry}"
                                MaxLength="20"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16">
                    <Button
                        Text="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelJoinGroupCommand}"/>
                    <Button
                        Grid.Column="1"
                        Text="Unirse"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding JoinGroupCommand}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>