<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Waybon.App.ViewModels"
    x:Class="Waybon.App.Views.Components.BottomNavigationView"
    x:DataType="vm:MainViewModel">

    <Grid
        Margin="16,0,16,16"
        HeightRequest="80">
        <Border
            BackgroundColor="{StaticResource White}"
            Stroke="{StaticResource Stone300}"
            StrokeThickness="1"
            StrokeShape="Rectangle"
            Padding="4">

            <Grid
                ColumnDefinitions="*,1,*,1,*">

                <!-- Map tab -->
                <Grid
                    BackgroundColor="{Binding MapButtonBackground}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectMapCommand}"/>
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="2">
                        <Path
                            Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                            Fill="{Binding MapButtonTextColor}"
                            Aspect="Uniform"
                            HeightRequest="24"
                            WidthRequest="24"/>
                        <Label
                            Text="Mapa"
                            FontFamily="Text-Variable"
                            FontSize="13"
                            TextColor="{Binding MapButtonTextColor}"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Divider -->
                <BoxView
                    Grid.Column="1"
                    Style="{StaticResource Divider}"
                    VerticalOptions="Fill"
                    Margin="0,12"/>

                <!-- Groups tab -->
                <Grid
                    Grid.Column="2"
                    BackgroundColor="{Binding GroupsButtonBackground}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectGroupsCommand}"/>
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="2">
                        <Path
                            Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                            Fill="{Binding GroupsButtonTextColor}"
                            Aspect="Uniform"
                            HeightRequest="24"
                            WidthRequest="38"/>
                        <Label
                            Text="Grupos"
                            FontFamily="Text-Variable"
                            FontSize="13"
                            TextColor="{Binding GroupsButtonTextColor}"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Divider -->
                <BoxView
                    Grid.Column="3"
                    Style="{StaticResource Divider}"
                    VerticalOptions="Fill"
                    Margin="0,12"/>

                <!-- Profile tab -->
                <Grid
                    Grid.Column="4"
                    BackgroundColor="{Binding ProfileButtonBackground}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectProfileCommand}"/>
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="2">
                        <Path
                            Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                            Fill="{Binding ProfileButtonTextColor}"
                            Aspect="Uniform"
                            HeightRequest="24"
                            WidthRequest="24"/>
                        <Label
                            Text="Perfil"
                            FontFamily="Text-Variable"
                            FontSize="13"
                            TextColor="{Binding ProfileButtonTextColor}"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</ContentView>