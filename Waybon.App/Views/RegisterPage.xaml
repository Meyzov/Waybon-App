<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Waybon.App.Views.RegisterPage"
    xmlns:vm="clr-namespace:Waybon.App.ViewModels"
    x:DataType="vm:RegisterViewModel"
    BackgroundColor="{StaticResource Stone100}"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <!-- Outer layout -->
        <Grid Padding="0" VerticalOptions="Center" HorizontalOptions="Fill">

            <!-- Register card container -->
            <Border Style="{StaticResource CardBorder}" 
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="420"
                    Margin="16,0">

                <VerticalStackLayout Spacing="0">

                    <!-- Section header -->
                    <Border Style="{StaticResource SectionHeaderBorder}">
                        <Label
                            Text="Registro"
                            Style="{StaticResource SectionHeaderLabel}"/>
                    </Border>

                    <!-- Form content -->
                    <VerticalStackLayout Spacing="0">

                        <!-- Username field -->
                        <VerticalStackLayout Spacing="4" Margin="0,0,0,16">
                            <Label Text="Nombre de usuario" Style="{StaticResource FormLabel}"/>

                            <Border Style="{StaticResource FormFieldBorder}">
                                <Entry
                                    Text="{Binding Username}"
                                    Style="{StaticResource FormEntry}"
                                    Placeholder="usuario123"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Email field -->
                        <VerticalStackLayout Spacing="4" Margin="0,0,0,16">
                            <Label Text="Email" Style="{StaticResource FormLabel}"/>

                            <Border Style="{StaticResource FormFieldBorder}">
                                <Entry
                                    Text="{Binding Email}"
                                    Keyboard="Email"
                                    Style="{StaticResource FormEntry}"
                                    Placeholder="correo@ejemplo.com"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password field -->
                        <VerticalStackLayout Spacing="4" Margin="0,0,0,16">
                            <Label Text="Contraseña" Style="{StaticResource FormLabel}"/>

                            <Border Style="{StaticResource FormFieldBorder}" Padding="0">
                                <Grid ColumnDefinitions="*,1,48">
                                    <Entry
                                        Grid.Column="0"
                                        Text="{Binding Password}"
                                        IsPassword="{Binding IsPassword}"
                                        Style="{StaticResource FormEntry}"
                                        Margin="8,0,8,0"
                                        Placeholder="••••••••"/>

                                    <!-- Divider -->
                                    <BoxView 
                                        Grid.Column="1" 
                                        WidthRequest="1" 
                                        Color="{StaticResource Stone400}" 
                                        VerticalOptions="Fill" 
                                        Margin="0,0"/>

                                    <!-- Password visibility toggle -->
                                    <Grid Grid.Column="2" BackgroundColor="{StaticResource Stone200}">
                                        <Path
                                            Fill="Transparent"
                                            Stroke="{StaticResource Stone600}"
                                            StrokeThickness="2"
                                            WidthRequest="20"
                                            HeightRequest="20"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Aspect="Uniform">
                                            <Path.Triggers>
                                                <DataTrigger TargetType="Path" Binding="{Binding IsPassword}" Value="True">
                                                    <Setter Property="Data" Value="M4 10.5C6.6 13.5 9.3 15 12 15s5.4-1.5 8-4.5 M12 15v3 M7.5 13.5l-1.5 3 M16.5 13.5l1.5 3" />
                                                    <Setter Property="TranslationY" Value="1.5" />
                                                </DataTrigger>

                                                <DataTrigger TargetType="Path" Binding="{Binding IsPassword}" Value="False">
                                                    <Setter Property="Data" Value="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </DataTrigger>
                                            </Path.Triggers>
                                        </Path>

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding TogglePasswordCommand}"/>
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Role field -->
                        <VerticalStackLayout Spacing="4" Margin="0,0,0,24">
                            <Label Text="Rol" Style="{StaticResource FormLabel}"/>

                            <Border Style="{StaticResource FormFieldBorder}">
                                <Entry
                                    Text="{Binding RoleName}"
                                    Style="{StaticResource FormEntry}"
                                    Placeholder="Rol de usuario"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Divider -->
                        <BoxView Style="{StaticResource Divider}" Margin="0,0,0,20"/>

                        <!-- Action buttons -->
                        <Button
                            Text="{Binding RegisterButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,0,12"
                            Command="{Binding RegisterCommand}"/>

                        <Button
                            Text="Volver a iniciar sesión"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,0,0"
                            Command="{Binding NavigateToLoginCommand}"/>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>