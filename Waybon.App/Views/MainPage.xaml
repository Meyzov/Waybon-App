<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Waybon.App.Views.MainPage"
    xmlns:vm="clr-namespace:Waybon.App.ViewModels"
    xmlns:models="clr-namespace:Waybon.App.Models"
    x:DataType="vm:MainViewModel"
    x:Name="Main"
    BackgroundColor="{StaticResource Stone100}"
    Shell.NavBarIsVisible="False">

    <!-- Resources -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Page Load Trigger -->
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding InitializeMainCommand}"
            BindingContext="{Binding Source={x:Reference Main}, Path=BindingContext}" />
    </ContentPage.Behaviors>

    <!-- Root Layout -->
    <Grid RowDefinitions="*,Auto">

        <!-- Content Panels -->
        <Grid Grid.Row="0" RowDefinitions="Auto,*">

            <!-- Ad Banner -->
            <Border
                Grid.Row="0"
                IsVisible="{Binding IsMapVisible}"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Stone300}"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                HeightRequest="80"
                Margin="16,16,16,8"
                Padding="0">
                <Label
                    Text="Banner"
                    FontFamily="PTSerifRegular"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Stone500}"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            </Border>

            <!-- Map Container -->
            <Border
                Grid.Row="1"
                IsVisible="{Binding IsMapVisible}"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Stone300}"
                StrokeThickness="1"
                Margin="16,0,16,8"
                Padding="0">
                <WebView
                    Source="{Binding MapSource}"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill"/>
            </Border>

            <!-- Groups Module -->
            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                IsVisible="{Binding IsGroupsVisible}"
                Margin="16,16,16,8">

                <!-- Groups List -->
                <Border
                    IsVisible="{Binding Group.IsGroupSelected, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource Stone300}"
                    StrokeThickness="1"
                    Padding="16">

                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- Groups Header -->
                        <VerticalStackLayout Grid.Row="0" Spacing="0">
                            <Border
                                BackgroundColor="{StaticResource Stone800}"
                                Stroke="{StaticResource Stone800}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="1"
                                Margin="0,0,0,16">

                                <Label
                                    Text="Mis Grupos"
                                    FontFamily="PTSerifRegular"
                                    FontSize="30"
                                    BackgroundColor="{StaticResource Stone800}"
                                    TextColor="{StaticResource White}"
                                    HorizontalOptions="Center"
                                    Margin="8,8,8,8"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Groups Content -->
                        <Grid Grid.Row="2" BindingContext="{Binding Group}" x:DataType="vm:GroupViewModel">
                            <Grid RowDefinitions="*">
                                <!-- Loading State -->
                                <Label
                                    Text="Cargando grupos..."
                                    IsVisible="{Binding IsGroupsLoaderVisible}"
                                    FontFamily="PTSerifRegular"
                                    FontSize="16"
                                    TextColor="{StaticResource Stone500}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                                <!-- Groups Collection -->
                                <CollectionView 
                                    ItemsSource="{Binding JoinedGroups}" 
                                    IsVisible="{Binding AreGroupsVisible}">

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout
                                            Orientation="Vertical"
                                            Span="1"
                                            VerticalItemSpacing="16"/>
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:GroupDetails">
                                            <Border
                                                BackgroundColor="#FAFAF9"
                                                Stroke="{StaticResource Stone300}"
                                                StrokeThickness="1"
                                                StrokeShape="Rectangle"
                                                Padding="16">

                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupViewModel}}, Path=SelectGroupCommand}" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>

                                                <VerticalStackLayout Spacing="0">
                                                    <!-- Group Icon + Name + Chevron -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <!-- Icon -->
                                                        <Border
                                                            Grid.Column="0"
                                                            WidthRequest="50"
                                                            HeightRequest="50"
                                                            BackgroundColor="{StaticResource Stone200}"
                                                            Stroke="{StaticResource Stone300}"
                                                            StrokeThickness="1"
                                                            StrokeShape="Rectangle"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Center">

                                                            <Path
                                                                Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                                                Fill="{StaticResource Stone400}"
                                                                Aspect="Uniform"
                                                                HeightRequest="30"
                                                                WidthRequest="30"
                                                                HorizontalOptions="Center"
                                                                VerticalOptions="Center"/>
                                                        </Border>

                                                        <!-- Name -->
                                                        <Label
                                                            Grid.Column="1"
                                                            Text="{Binding Name}"
                                                            FontFamily="PTSerifRegular"
                                                            FontSize="16"
                                                            TextColor="{StaticResource Stone700}"
                                                            FontAttributes="Bold"
                                                            VerticalOptions="Center"
                                                            Margin="8,0,0,0"/>

                                                        <!-- Chevron -->
                                                        <Path
                                                            Grid.Column="2"
                                                            Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"
                                                            Fill="{StaticResource Stone400}"
                                                            Aspect="Uniform"
                                                            HeightRequest="16"
                                                            WidthRequest="15"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="End"/>
                                                    </Grid>

                                                    <BoxView
                                                        HeightRequest="1"
                                                        Color="{StaticResource Stone300}"
                                                        Margin="0,12,0,12"/>

                                                    <!-- Group Owner -->
                                                    <Border
                                                        BackgroundColor="{StaticResource White}"
                                                        Stroke="{StaticResource Stone300}"
                                                        StrokeThickness="1"
                                                        StrokeShape="Rectangle"
                                                        Padding="8,4"
                                                        Margin="0,0,0,12"
                                                        HorizontalOptions="Start">

                                                        <Label
                                                            Text="{Binding DisplayUsername, StringFormat='Propietario: {0}'}"
                                                            FontFamily="PTSerifRegular"
                                                            FontSize="11"
                                                            TextColor="{StaticResource Stone500}"
                                                            LineBreakMode="NoWrap"/>
                                                    </Border>

                                                    <!-- Created Date -->
                                                    <Label
                                                        Text="{Binding CreatedAt, StringFormat='Creado: {0:dd/MM/yyyy}'}"
                                                        FontFamily="PTSerifRegular"
                                                        FontSize="11"
                                                        TextColor="{StaticResource Stone500}"
                                                        HorizontalOptions="End"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <!-- Empty State -->
                                <Label
                                    IsVisible="{Binding IsNoGroupsMessageVisible}"
                                    Text="No se encontraron grupos."
                                    FontFamily="PTSerifRegular"
                                    FontSize="16"
                                    TextColor="{StaticResource Stone500}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Group Members List -->
                <Border
                    IsVisible="{Binding Group.IsGroupSelected}"
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource Stone300}"
                    StrokeThickness="1"
                    Padding="16">

                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" BindingContext="{Binding Group}" x:DataType="vm:GroupViewModel">

                        <!-- Members Header -->
                        <VerticalStackLayout Grid.Row="0" Spacing="0">
                            <Border
                                BackgroundColor="{StaticResource Stone800}"
                                Stroke="{StaticResource Stone800}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="1"
                                Margin="0,0,0,16">

                                <Label
                                    Text="{Binding SelectedGroupName}"
                                    FontFamily="PTSerifRegular"
                                    FontSize="30"
                                    BackgroundColor="{StaticResource Stone800}"
                                    TextColor="{StaticResource White}"
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,8"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Members Content -->
                        <Grid Grid.Row="2" Margin="0,0,0,24">
                            <Grid RowDefinitions="*">
                                <!-- Loading State -->
                                <Label
                                    Text="Cargando miembros..."
                                    IsVisible="{Binding IsMembersLoaderVisible}"
                                    FontFamily="PTSerifRegular"
                                    FontSize="16"
                                    TextColor="{StaticResource Stone500}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                                <!-- Members Collection -->
                                <CollectionView 
                                    ItemsSource="{Binding GroupMembers}" 
                                    IsVisible="{Binding AreMembersVisible}">

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout
                                            Orientation="Vertical"
                                            Span="1"
                                            VerticalItemSpacing="16"/>
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:GroupMember">
                                            <Border
                                                BackgroundColor="#FAFAF9"
                                                Stroke="{StaticResource Stone300}"
                                                StrokeThickness="1"
                                                StrokeShape="Rectangle"
                                                Padding="16">

                                                <VerticalStackLayout Spacing="0">
                                                    <!-- Member Icon + Name -->
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Border
                                                            WidthRequest="50"
                                                            HeightRequest="50"
                                                            BackgroundColor="{StaticResource Stone200}"
                                                            Stroke="{StaticResource Stone300}"
                                                            StrokeThickness="1"
                                                            StrokeShape="Rectangle"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Center">

                                                            <Path
                                                                Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                                                Fill="{StaticResource Stone400}"
                                                                Aspect="Uniform"
                                                                HeightRequest="24"
                                                                WidthRequest="20"
                                                                HorizontalOptions="Center"
                                                                VerticalOptions="Center"/>
                                                        </Border>

                                                        <Label
                                                            Text="{Binding DisplayUsername}"
                                                            FontFamily="PTSerifRegular"
                                                            FontSize="16"
                                                            TextColor="{StaticResource Stone700}"
                                                            FontAttributes="Bold"
                                                            VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>

                                                    <BoxView
                                                        HeightRequest="1"
                                                        Color="{StaticResource Stone300}"
                                                        Margin="0,12,0,12"/>

                                                    <!-- Member Details -->
                                                    <VerticalStackLayout Spacing="4">
                                                        <!-- Tags -->
                                                        <FlexLayout
                                                            Direction="Row"
                                                            Wrap="Wrap"
                                                            AlignItems="Start"
                                                            JustifyContent="Start"
                                                            Margin="0,0,0,8"
                                                            BindableLayout.ItemsSource="{Binding Tags}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border
                                                                        BackgroundColor="{StaticResource White}"
                                                                        Stroke="{StaticResource Stone300}"
                                                                        StrokeThickness="1"
                                                                        StrokeShape="Rectangle"
                                                                        Padding="8,4"
                                                                        Margin="0,0,8,8">
            
                                                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                                            <!-- Indicator -->
                                                                            <Border
                                                                                WidthRequest="8"
                                                                                HeightRequest="8"
                                                                                StrokeThickness="0"
                                                                                VerticalOptions="Center">
                                                                                <Border.StrokeShape>
                                                                                    <RoundRectangle CornerRadius="100"/>
                                                                                </Border.StrokeShape>
                                                                                <Border.Triggers>
                                                                                    <!-- Sharing -->
                                                                                    <DataTrigger TargetType="Border" Binding="{Binding .}" Value="Compartiendo">
                                                                                        <Setter Property="BackgroundColor" Value="Green"/>
                                                                                    </DataTrigger>
                                                                                    <!-- Not Sharing -->
                                                                                    <DataTrigger TargetType="Border" Binding="{Binding .}" Value="No Compartiendo">
                                                                                        <Setter Property="BackgroundColor" Value="Red"/>
                                                                                    </DataTrigger>
                                                                                </Border.Triggers>
                                                                            </Border>

                                                                            <!-- Tag Text -->
                                                                            <Label
                                                                                Text="{Binding .}"
                                                                                FontFamily="PTSerifRegular"
                                                                                FontSize="11"
                                                                                TextColor="{StaticResource Stone500}"
                                                                                VerticalOptions="Center"
                                                                                LineBreakMode="NoWrap"/>
                                                                        </HorizontalStackLayout>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </FlexLayout>

                                                        <!-- Last Activity -->
                                                        <Label
                                                            Text="{Binding LastActivityAt, StringFormat='Última actividad: {0:dd/MM/yyy - HH:mm}'}"
                                                            FontFamily="PTSerifRegular"
                                                            FontSize="11"
                                                            TextColor="{StaticResource Stone500}"
                                                            HorizontalOptions="End"
                                                            Margin="0,0,2,0"/>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <!-- Empty State -->
                                <Label
                                    IsVisible="{Binding IsNoMembersMessageVisible}"
                                    Text="No se encontraron miembros en este grupo."
                                    FontFamily="PTSerifRegular"
                                    FontSize="16"
                                    TextColor="{StaticResource Stone500}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Bottom Separator -->
                        <BoxView
                            Grid.Row="3"
                            HeightRequest="1"
                            Color="{StaticResource Stone300}"
                            Margin="0,0,0,16"/>

                        <!-- Back Button -->
                        <Button
                            Grid.Row="4"
                            Text="Volver a mis grupos"
                            FontFamily="PTSerifRegular"
                            FontSize="16"
                            BackgroundColor="{StaticResource Stone800}"
                            TextColor="{StaticResource White}"
                            BorderColor="{StaticResource Stone800}"
                            BorderWidth="1"
                            CornerRadius="0"
                            HeightRequest="40"
                            Command="{Binding BackToGroupsCommand}"/>

                    </Grid>
                </Border>

            </Grid>

            <!-- Profile Panel -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                IsVisible="{Binding IsProfileVisible}"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Stone300}"
                StrokeThickness="1"
                Margin="16,16,16,8"
                Padding="16">

                <Grid RowDefinitions="Auto,*,Auto" BindingContext="{Binding Profile}" x:DataType="vm:ProfileViewModel">

                    <!-- Profile Content (Header + Card + Separador) -->
                    <VerticalStackLayout Grid.Row="0" Spacing="0">
                        <!-- Profile Header -->
                        <Border
                            BackgroundColor="{StaticResource Stone800}"
                            Stroke="{StaticResource Stone800}"
                            StrokeThickness="1"
                            StrokeShape="Rectangle"
                            Padding="1"
                            Margin="0,0,0,16">

                            <Label
                                Text="Panel de Usuario"
                                FontFamily="PTSerifRegular"
                                FontSize="30"
                                BackgroundColor="{StaticResource Stone800}"
                                TextColor="{StaticResource White}"
                                HorizontalOptions="Center"
                                Margin="0,8,0,8"/>
                        </Border>

                        <!-- User Card -->
                        <Border
                            BackgroundColor="#FAFAF9"
                            Stroke="{StaticResource Stone200}"
                            StrokeThickness="1"
                            StrokeShape="Rectangle"
                            Padding="24"
                            Margin="0,0,0,16">
                            <HorizontalStackLayout Spacing="24" VerticalOptions="Center">
                                <Border
                                    WidthRequest="70"
                                    HeightRequest="70"
                                    BackgroundColor="{StaticResource Stone200}"
                                    Stroke="{StaticResource Stone300}"
                                    StrokeThickness="1"
                                    StrokeShape="Rectangle"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                    <Path
                                        Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                        Fill="{StaticResource Stone400}"
                                        Aspect="Uniform"
                                        HeightRequest="32"
                                        WidthRequest="40"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                    <Label
                                        Text="{Binding Username}"
                                        FontFamily="PTSerifRegular"
                                        FontSize="24"
                                        TextColor="{StaticResource Stone800}"
                                        FontAttributes="Bold"/>
                                    <Label
                                        Text="{Binding RoleName}"
                                        FontFamily="PTSerifRegular"
                                        FontSize="16"
                                        TextColor="{StaticResource Stone600}"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource Stone300}"
                            Margin="0,0,0,16"/>
                    </VerticalStackLayout>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="16" VerticalOptions="Start">

                            <!-- Location Sharing -->
                            <Border
                                BackgroundColor="#FAFAF9"
                                Stroke="{StaticResource Stone200}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="24">

                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label
                                        Grid.Column="0"
                                        Text="Compartir ubicación"
                                        FontFamily="PTSerifRegular"
                                        FontSize="16"
                                        TextColor="{StaticResource Stone600}"
                                        VerticalOptions="Center"/>

                                    <!-- Custom Square Toggle -->
                                    <Grid
                                        Grid.Column="1"
                                        WidthRequest="56"
                                        HeightRequest="32"
                                        VerticalOptions="Center">

                                        <!-- Track -->
                                        <Border
                                            Stroke="{StaticResource Stone400}"
                                            StrokeThickness="1"
                                            BackgroundColor="{StaticResource Stone200}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSharingEnabled}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Stone800}"/>
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <!-- Thumb -->
                                            <Border
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                BackgroundColor="{StaticResource White}"
                                                Stroke="{StaticResource Stone400}"
                                                StrokeThickness="1"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center"
                                                Margin="1,0,0,0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSharingEnabled}" Value="True">
                                                        <Setter Property="HorizontalOptions" Value="End"/>
                                                        <Setter Property="Margin" Value="0,0,1,0"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </Border>

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleSharingCommand}"/>
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleSharingCommand}"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>

                            <!--
                            <Border ...>
                                ...
                            </Border>
                            -->

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Logout Section -->
                    <VerticalStackLayout Grid.Row="2" Spacing="0">
                        <BoxView HeightRequest="1" Color="{StaticResource Stone300}" Margin="0,16,0,16"/>
                        <Button
                            Text="Cerrar Sesión"
                            FontFamily="PTSerifRegular"
                            FontSize="16"
                            BackgroundColor="{StaticResource Stone800}"
                            TextColor="{StaticResource White}"
                            BorderColor="{StaticResource Stone800}"
                            BorderWidth="1"
                            CornerRadius="0"
                            HeightRequest="40"
                            Command="{Binding LogoutCommand}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Bottom Navigation Bar -->
        <Grid
            Grid.Row="1"
            Margin="16,0,16,16"
            HeightRequest="80">

            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Stone300}"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                Padding="4">

                    <Grid ColumnDefinitions="*,Auto,*,Auto,*">

                        <!-- Map Tab -->
                        <Grid
                        Grid.Column="0"
                        BackgroundColor="{Binding MapButtonBackground}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectMapCommand}"/>
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="2">
                                <Path
                                Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                Fill="{Binding MapButtonTextColor}"
                                Aspect="Uniform"
                                HeightRequest="24"
                                WidthRequest="24"/>
                                <Label
                                Text="Mapa"
                                FontFamily="PTSerifRegular"
                                FontSize="13"
                                TextColor="{Binding MapButtonTextColor}"
                                HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Groups Tab -->
                        <Grid
                        Grid.Column="2"
                        BackgroundColor="{Binding GroupsButtonBackground}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectGroupsCommand}"/>
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="2">
                                <!-- Groups Icon -->
                                <Path
                                Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                Fill="{Binding GroupsButtonTextColor}"
                                Aspect="Uniform"
                                HeightRequest="24"
                                WidthRequest="38"/>
                                <Label
                                Text="Grupos"
                                FontFamily="PTSerifRegular"
                                FontSize="13"
                                TextColor="{Binding GroupsButtonTextColor}"
                                HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Profile Tab -->
                        <Grid
                        Grid.Column="4"
                        BackgroundColor="{Binding ProfileButtonBackground}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectProfileCommand}"/>
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="2">
                                <Path
                                Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                Fill="{Binding ProfileButtonTextColor}"
                                Aspect="Uniform"
                                HeightRequest="24"
                                WidthRequest="24"/>
                                <Label
                                Text="Perfil"
                                FontFamily="PTSerifRegular"
                                FontSize="13"
                                TextColor="{Binding ProfileButtonTextColor}"
                                HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>