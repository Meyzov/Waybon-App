<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Waybon.App.Views.Popups.CustomAlertPopup"
    CanBeDismissedByTappingOutsideOfPopup="false"
    BackgroundColor="Transparent"
    Shell.NavBarIsVisible="False">

    <Grid
        Margin="24"
        VerticalOptions="Center"
        HorizontalOptions="Center"
        WidthRequest="267"
        BackgroundColor="Transparent">

        <Border Style="{StaticResource CardBorder}" Padding="16">

            <VerticalStackLayout Spacing="16">

                <!-- Title -->
                <Border
                    BackgroundColor="{StaticResource Stone800}"
                    Stroke="{StaticResource Stone800}"
                    StrokeThickness="1"
                    StrokeShape="Rectangle"
                    Padding="0,10">

                    <Label
                        x:Name="TitleLabel"
                        FontFamily="Text-Variable"
                        FontSize="18"
                        TextColor="{StaticResource White}"
                        HorizontalOptions="Center"/>
                </Border>

                <!-- Message -->
                <Border
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource Stone300}"
                    StrokeThickness="1"
                    StrokeShape="Rectangle"
                    Padding="16">

                    <Label
                        x:Name="MessageLabel"
                        FontFamily="Text-Variable"
                        FontSize="14"
                        TextColor="{StaticResource Stone700}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>
                </Border>

                <!-- Buttons -->
                <Grid x:Name="ButtonsGrid" ColumnDefinitions="*,8,*">
                    <Button
                        x:Name="CancelButton"
                        Grid.Column="0"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="44"
                        Clicked="OnCancelClicked"/>

                    <Button
                        x:Name="AcceptButton"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="44"
                        Clicked="OnAcceptClicked"/>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>
</toolkit:Popup>