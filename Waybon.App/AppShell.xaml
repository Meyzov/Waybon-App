<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Waybon.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Waybon.App.Views"
    FlyoutBehavior="Disabled">

    <!-- Login route -->
    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}"/>

    <!-- Main app route (temporary placeholder) -->
    <ShellContent
        Route="profile"
        ContentTemplate="{DataTemplate views:ProfilePage}"/>

    <!-- Register route (temporary, also points to placeholder) -->
    <ShellContent
        Route="register"
        ContentTemplate="{DataTemplate views:ProfilePage}"/>

</Shell>