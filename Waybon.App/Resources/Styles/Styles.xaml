<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="Stroke" Value="{StaticResource Stone300}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="PTSerifRegular" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource Stone800}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="FormLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="PTSerifRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Stone700}" />
    </Style>

    <Style x:Key="FormEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="PTSerifRegular" />
        <Setter Property="TextColor" Value="{StaticResource Stone900}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Stone800}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="PTSerifRegular" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Stone800}" />
        <Setter Property="BorderColor" Value="{StaticResource Stone800}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="PTSerifRegular" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

</ResourceDictionary>