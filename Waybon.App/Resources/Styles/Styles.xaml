<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Section Headers -->
    <Style x:Key="SectionHeaderBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Stone800}" />
        <Setter Property="Stroke" Value="{StaticResource Stone800}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

    <Style x:Key="SectionHeaderLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Text-Variable" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Cards -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="Stroke" Value="{StaticResource Stone300}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

    <Style x:Key="CardBorderLight" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Stone50}" />
        <Setter Property="Stroke" Value="{StaticResource Stone300}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

    <!-- Forms and Inputs -->
    <Style x:Key="FormLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Text-Variable" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Stone600}" />
    </Style>

    <Style x:Key="FormFieldBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Stone400}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="FormEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource Stone800}"/>
        <Setter Property="FontFamily" Value="Text-Variable" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Stone800}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="Text-Variable" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Stone800}" />
        <Setter Property="BorderColor" Value="{StaticResource Stone800}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="Text-Variable" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!-- General Text Styles -->
    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Text-Variable" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Stone600}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="BoldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Text-Variable" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Stone800}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="IconContainer" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Stone200}" />
        <Setter Property="Stroke" Value="{StaticResource Stone300}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource Stone300}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="LinkLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Text-Variable" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Stone500}" />
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

</ResourceDictionary>